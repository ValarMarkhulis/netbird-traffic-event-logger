# Copy this file to docker/.env before running:
#   cd docker && docker compose -f docker-compose.production.yml up -d --build
#
# docker compose automatically loads a .env file from the directory the
# command is run from (docker/), so these values are picked up without
# any extra flags.

# Required — shared HMAC-SHA256 secret used to authenticate NetBird clients
# connecting to the flow server. Must match NB_FLOW_SECRET set on the
# management service. If this is left unset, `docker compose up` will fail
# fast instead of silently deploying without authentication.
NB_FLOW_SECRET=

# Optional — override the default Postgres credentials/db name shared by
# flow-server, etl, and postgres. Defaults shown below match what ships in
# docker-compose.production.yml if left unset.
POSTGRES_USER=netbird
POSTGRES_PASSWORD=netbird
POSTGRES_DB=netbird_traffic_event_logging
