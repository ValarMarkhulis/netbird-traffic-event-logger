    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go: Launch client",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/client",
        },
        {
            "name": "Go: Launch csv-client",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/client/csv-replay",
            "args": ["${workspaceFolder}/tests/2025-12-07-client-v0530-3-rdp-session-after-each-other-long-test.csv"]
        },
        {
            "name": "Go: Launch server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "args": ["--debug"]
        },
        {
            "name": "Go: Launch go-etl",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/go-etl/main.go",
            "envFile": "${workspaceFolder}/go-etl/.env",
            "args": ["--db", "--debug", "--window", "87600h"]
        }


    ]
}